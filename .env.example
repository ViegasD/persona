# ─── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://yourdomain.com

# ─── Database (PostgreSQL) ───────────────────────────────
POSTGRES_USER=persona
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=persona
DATABASE_URL=postgresql://persona:CHANGE_ME_strong_password_here@postgres:5432/persona

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Evolution API (WhatsApp) ────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_generate_a_random_key
EVOLUTION_INSTANCE_NAME=persona-bot
EVOLUTION_WEBHOOK_SECRET=

# ─── Mercado Pago ────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Kie.ai (legacy — optional) ──────────────────────────
# KIE_API_URL=https://api.kie.ai
# KIE_API_KEY=your_kie_api_key_here

# ─── xAI / Grok Video ───────────────────────────────────
XAI_API_KEY=your_xai_api_key_here
XAI_API_URL=https://api.x.ai/v1
VIDEO_DURATION=10
VIDEO_ASPECT_RATIO=9:16
VIDEO_RESOLUTION=720p

# ─── S3 / MinIO ─────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=persona-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_strong_minio_password
S3_FORCE_PATH_STYLE=true

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_random_string_with_at_least_32_chars
JWT_GALLERY_EXPIRY=24h

# ─── Limits ─────────────────────────────────────────────
MAX_REFERENCE_IMAGES=5
MESSAGE_DEBOUNCE_MS=12000
