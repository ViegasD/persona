# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001

# ─── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://ensaio:ensaio_dev_123@localhost:5432/ensaio

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
MESSAGE_DEBOUNCE_MS=12000

# ─── Evolution API (WhatsApp) ────────────────────────────
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=ensaio-bot
EVOLUTION_WEBHOOK_SECRET=optional_webhook_secret

# ─── Mercado Pago ────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=optional_mp_webhook_secret

# ─── Kie.ai ─────────────────────────────────────────────
KIE_API_URL=https://api.kie.ai
KIE_API_KEY=your_kie_api_key_here

# ─── S3 / MinIO ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ensaio-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# ─── WhatsApp Cloud API (Meta official, optional) ────
# Only needed if using Meta's official Cloud API alongside or instead of Evolution API
WA_CLOUD_API_TOKEN=your_whatsapp_cloud_api_token
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_APP_SECRET=your_facebook_app_secret

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_GALLERY_EXPIRY=24h

# ─── Limits ─────────────────────────────────────────────
MAX_REFERENCE_IMAGES=10

# ─── Next.js (apps/web) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
