{
  "name": "persona",
  "version": "1.0.0",
  "private": true,
  "description": "Funil WhatsApp com IA para vídeos personalizados",
  "scripts": {
    "dev:backend": "pnpm --filter @persona/backend dev",
    "dev:web": "pnpm --filter @persona/web dev",
    "dev": "pnpm run --parallel dev:backend dev:web",
    "build": "pnpm run --filter @persona/* build",
    "db:migrate": "pnpm --filter @persona/backend prisma:migrate",
    "db:generate": "pnpm --filter @persona/backend prisma:generate",
    "db:seed": "pnpm --filter @persona/backend prisma:seed",
    "lint": "pnpm run --filter @persona/* lint"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
